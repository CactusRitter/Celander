<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- Adaptive icons must stay in a -v26 folder; aapt2 does not resolve them from mipmap-anydpi. -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>
    <!-- The wallpaper is only handed out with access to all photos; a selection is deliberately not used (WallpaperBlur). -->
    <issue id="SelectedPhotoAccess">
        <ignore path="src/main/AndroidManifest.xml" />
    </issue>
</lint>
