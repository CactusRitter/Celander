<?xml version="1.0" encoding="utf-8"?>
<!-- The thin light edge of a widget card, tinted in code for day and night. A drawable and not a picture, so it keeps its corner radius whatever size the launcher gives the widget. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <stroke android:width="1dp" android:color="#80FFFFFF" />
    <corners android:radius="24dp" />
</shape>
